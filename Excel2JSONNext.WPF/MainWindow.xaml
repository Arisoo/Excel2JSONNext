<Window x:Name="window" x:Class="Excel2JSONNext.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Excel2JSONNext.WPF"
        xmlns:viewModels="Excel2JSONCoreLib.ViewModels.MainWindowViewModel"
        mc:Ignorable="d"
        Title="Excel2JSON Next (must use Newtonsoft.Json , com.unity.nuget.newtonsoft-json)" Height="450" Width="800">
    <Grid Cursor="">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="78*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="160*"/>
            <RowDefinition Height="255*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="tabControl" Grid.Column="1" Grid.Row="1" Grid.RowSpan="2">
            <TabItem Header="일괄 처리">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12*"/>
                        <ColumnDefinition Width="755*"/>
                        <ColumnDefinition Width="7*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="115"/>
                        <RowDefinition Height="250*"/>
                        <RowDefinition Height="7*"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Column="1" Content="from Excels" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" Width="72" Grid.Row="1"/>
                    <Label Grid.Column="1" Content="to JSON" HorizontalAlignment="Left" Margin="17,26,0,0" Grid.Row="1" VerticalAlignment="Top" Height="26" Width="55"/>
                    <Label Content="to Classes" HorizontalAlignment="Left" Margin="7,54,0,0" Grid.Row="1" VerticalAlignment="Top" Grid.Column="1" Height="26" Width="64"/>
                    <TextBox IsReadOnly="False" Text="{Binding XlsxFolder, Mode=TwoWay}"
                        Grid.Column="1" HorizontalAlignment="Left" Margin="77,4,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="553" Height="22"/>
                    <TextBox IsReadOnly="False" Text="{Binding JsonFolder, Mode=TwoWay}" 
                        Grid.Column="1" HorizontalAlignment="Left" Margin="77,31,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="553" Height="22"/>
                    <TextBox  IsReadOnly="False" Text="{Binding ClsFolder, Mode=TwoWay}"
                        Grid.Column="1" HorizontalAlignment="Left" Margin="77,58,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="508" Height="22"/>
                    <Label Content="namespace" HorizontalAlignment="Left" Margin="1,85,0,0" Grid.Row="1" VerticalAlignment="Top" Grid.Column="1" Height="26" Width="71"/>
                    <TextBox Text="{Binding NamespaceForClasses, Mode=TwoWay}"
                        Grid.Column="1" HorizontalAlignment="Left" Margin="77,89,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="333" Height="22"/>
                    <Button x:Name="ChooseExcelFileFolder" Grid.Column="1" Content="..." 
                            HorizontalAlignment="Left" Margin="635,6,0,0" Grid.Row="1" VerticalAlignment="Top" Width="30" Height="20" 
                            Click="ChooseExcelFileFolder_Click"                            
                            />
                    <Button x:Name="ChooseJSONFileFolder" Grid.Column="1" Content="..." 
                            HorizontalAlignment="Left" Margin="635,32,0,0" Grid.Row="1" VerticalAlignment="Top" Width="30" Height="20" 
                            Click="ChooseJSONFileFolder_Click"/>
                    <Button x:Name="ChooseClassFileFolder" Grid.Column="1" Content="..." 
                            HorizontalAlignment="Left" Margin="590,60,0,0" Grid.Row="1" VerticalAlignment="Top" Width="30" Height="20" 
                            Click="ChooseClassFileFolder_Click"/>
                    <TextBox x:Name="logs" IsReadOnly="True" Text="{Binding LogText, Mode=OneWay}"
                                Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"
                                PreviewMouseLeftButtonDown="LogTextBox_PreviewMouseLeftButtonDown"
                                AcceptsReturn="True" 
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto"
                                IsEnabled="True" Focusable="True" Cursor="IBeam"
                                ForceCursor="True" IsManipulationEnabled="True" IsInactiveSelectionHighlightEnabled="True"/>
                    <Button x:Name="ExportJSON" Grid.Column="1" Content="Export JSON" 
                            HorizontalAlignment="Left" Margin="635,60,0,0" Grid.Row="1" VerticalAlignment="Top" Width="90" Height="20" 
                            Command="{Binding ExportJSONCommand}" />
                    <Button Grid.Column="1" Content="Export C# claases" 
                            HorizontalAlignment="Left" Margin="435,90,0,0" Grid.Row="1" VerticalAlignment="Top" Width="105" Height="20"
                            Command="{Binding ExportClassesCommand}"
                            />
                    <Button Grid.Column="1" Content="Export All" 
                            HorizontalAlignment="Left" Margin="545,91,0,0" Grid.Row="1" VerticalAlignment="Top" Width="90" Height="20"                            
                            Command="{Binding ExportAllCommand}"
                            />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 정석은 이 방식이 아니라, Modal Dialog 방식을 써야 함! -->
        <StackPanel Background="Gray" x:Name="stackPanel"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                    d:Visibility="Collapsed"
                    Grid.Row="1" Grid.Column="1"
                    
                    >


            <!-- 로딩 애니메이션이나 메시지 -->
            <TextBlock Text="백그라운드 처리 중입니다. 잠시만 기다려주세요..." 
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        FontSize="16" 
                        FontWeight="Bold"/>
            <ProgressBar IsIndeterminate="True" 
                            Width="300" 
                            Height="15" 
                            />
        </StackPanel>
    </Grid>
</Window>
